{
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/en/:path+", "destination": "/:path*", "permanent": true },
    { "source": "/pt", "destination": "/pt/", "permanent": true }
  ]
}
